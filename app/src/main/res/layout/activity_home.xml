<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:padding="16dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/textPrimary" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/heroCard"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardUseCompatPadding="true"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgCreateTask"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/books"   />

                    <!-- soft bottom gradient -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:foregroundGravity="bottom"
                        android:background="@drawable/img_scrim" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateTask"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_rounded"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="@string/create_task"
                    android:textAllCaps="false"
                    android:textColor="@color/colorSecondary"
                    android:textSize="14sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/colorAccent"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="345dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/today_tasks"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnYesterday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_chip"
                        app:useMaterialThemeColors="false"
                        android:text="@string/yesterday"
                        android:textAllCaps="false"
                        android:textColor="@color/textPrimary"
                        android:layout_marginEnd="8dp"/>

                    <Button
                        android:id="@+id/btnToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/btn_chip"
                        app:useMaterialThemeColors="false"
                        android:text="@string/today"
                        android:textAllCaps="false"
                        android:textColor="@color/colorSecondary" />

                    <Button
                        android:id="@+id/btnTomorrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_chip"
                        app:useMaterialThemeColors="false"
                        android:text="@string/tomorrow"
                        android:textAllCaps="false"
                        android:textColor="@color/textPrimary"/>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">

            </LinearLayout>

            <include
                android:id="@+id/task1"
                layout="@layout/view_task_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <include
                android:id="@+id/task2"
                layout="@layout/view_task_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <include
                android:id="@+id/task3"
                layout="@layout/view_task_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <include
                android:id="@+id/task4"
                layout="@layout/view_task_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <include
                android:id="@+id/task5"
                layout="@layout/view_task_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="100dp" />

            <TextView
                android:id="@+id/btnTasksSeeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all"
                android:textColor="@color/colorAccent" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_card"
        android:padding="8dp"
        app:menu="@menu/menu_bottom_nav"
        app:labelVisibilityMode="unlabeled"
        app:itemBackground="@android:color/transparent"
        app:itemIconTint="@color/colorAccent"
        app:itemRippleColor="@android:color/transparent"
        tools:ignore="BottomNavigationView" />
</RelativeLayout>
